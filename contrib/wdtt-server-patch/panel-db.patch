+// configurePanelDBForConfigDir sets panel.db path from -config-dir (headless / awg-manager).
+func configurePanelDBForConfigDir(configDir string) {
+	dir := strings.TrimSpace(configDir)
+	if dir == "" {
+		dir = "/etc/wdtt"
+	}
+	next := filepath.Join(dir, "panel.db")
+	if next == panelDBPath && serverPanelDB != nil {
+		return
+	}
+	panelDBPath = next
+	resetServerPanelDB()
+}
+
+func resetServerPanelDB() {
+	if serverPanelDB != nil {
+		_ = serverPanelDB.Close()
+	}
+	serverPanelDB = nil
+	serverPanelDBErr = nil
+	serverPanelDBOnce = sync.Once{}
+}
+
 func openServerPanelDB() (*sql.DB, error) {
 	serverPanelDBOnce.Do(func() {
+		if err := os.MkdirAll(filepath.Dir(panelDBPath), 0700); err != nil {
+			serverPanelDBErr = err
+			return
+		}
 		db, err := paneldb.Open(panelDBPath)
+		if err != nil {
+			db, err = openServerPanelDBCreate(panelDBPath)
+		}
 		if err != nil {
 			serverPanelDBErr = err
 			return
@@ -33,6 +65,23 @@ func openServerPanelDB() (*sql.DB, error) {
 	return serverPanelDB, serverPanelDBErr
 }
 
+func openServerPanelDBCreate(path string) (*sql.DB, error) {
+	db, err := sql.Open("sqlite", paneldb.DSN(path))
+	if err != nil {
+		return nil, err
+	}
+	db.SetMaxOpenConns(1)
+	if err := db.Ping(); err != nil {
+		db.Close()
+		return nil, err
+	}
+	if err := paneldb.EnsureWDTTSchema(db); err != nil {
+		db.Close()
+		return nil, err
+	}
+	return db, nil
+}
+
 func serverPanelDBReady() bool {
 	db, err := openServerPanelDB()
 	return err == nil && db != nil
