#!/bin/sh
# S97mihomo - Mihomo proxy engine service

ENABLED=yes
PROCS=mihomo
DESC="Mihomo Core"
BIN="/opt/etc/awg-manager/mihomo/mihomo"
CONF_DIR="/opt/etc/awg-manager/mihomo"
PID_FILE="/var/run/mihomo.pid"

is_running() {
    [ -n "$(pidof mihomo 2>/dev/null)" ]
}

start() {
    if is_running; then
        echo "$DESC already running (PID $(pidof mihomo))"
        return 0
    fi
    [ -x "$BIN" ] || { echo "Binary $BIN missing or not executable"; return 1; }
    echo "Starting $DESC..."
    cd "$CONF_DIR" && nohup "$BIN" -d "$CONF_DIR" >/opt/var/log/mihomo.log 2>&1 &
    sleep 2
    if is_running; then
        echo "$DESC started (PID $(pidof mihomo))"
    else
        echo "Failed to start $DESC"
        return 1
    fi
}

stop() {
    if is_running; then
        echo "Stopping $DESC..."
        local pids="$(pidof mihomo 2>/dev/null)"
        [ -n "$pids" ] && kill $pids 2>/dev/null
        local count=0
        while is_running && [ $count -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        pids="$(pidof mihomo 2>/dev/null)"
        [ -n "$pids" ] && kill -9 $pids 2>/dev/null || true
    fi
    echo "$DESC stopped"
}

status() {
    if is_running; then
        echo "$DESC is running (PID $(pidof mihomo))"
    else
        echo "$DESC is stopped"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
