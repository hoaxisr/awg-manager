From: Keenetic SDK Builder <developers@keenetic.com>
Subject: [PATCH] fix: awg_has_header_protection must not be declared inline

The function is declared `inline` in header_protection.h and defined in
header_protection.c, i.e. across translation units. On kernels that map
`inline` to `inline __attribute__((always_inline))` — 4.9 does — gcc
rejects every call site with "inlining failed in call to 'always_inline'
'awg_has_header_protection': function body not available".

Drop the inline qualifier; it was never able to inline across TUs anyway.

Signed-off-by: Keenetic SDK Builder <developers@keenetic.com>
---
diff --git a/src/header_protection.c b/src/header_protection.c
index 8efa4c2..8711b36 100644
--- a/src/header_protection.c
+++ b/src/header_protection.c
@@ -3,7 +3,7 @@
 
 #include <crypto/chacha.h>
 
-inline bool awg_has_header_protection(struct wg_device *wg) {
+bool awg_has_header_protection(struct wg_device *wg) {
 	struct header_protection* p = &wg->header_protection;
 	bool res;
 	down_read(&p->lock);
diff --git a/src/header_protection.h b/src/header_protection.h
index d57622e..90f0e56 100644
--- a/src/header_protection.h
+++ b/src/header_protection.h
@@ -19,7 +19,7 @@ struct header_protection {
     bool has_protection;
 };
 
-inline bool awg_has_header_protection(struct wg_device *wg);
+bool awg_has_header_protection(struct wg_device *wg);
 bool awg_header_protection_init(struct chacha_state *state, struct wg_device *dev, u8 *nonce);
 void awg_header_protection_set_key(struct header_protection *p, u8 key[HEADER_PROTECTION_KEY_SIZE]);
 void awg_header_protection_get_key(struct header_protection *p, u8 key[HEADER_PROTECTION_KEY_SIZE]);
