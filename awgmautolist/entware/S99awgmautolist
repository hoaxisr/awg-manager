#!/bin/sh
# Entware lifecycle for awgmautolist. Logging is owned by the daemon in tmpfs.

ENABLED=yes
PROG=/opt/bin/awgmautolist
PIDFILE=/opt/var/run/awgmautolist.pid
CONF_DIR="${AWGM_AUTOLIST_DIR:-/opt/etc/awgmautolist}"

# One-time migration of the pre-directory shell files into the working
# directory, BEFORE anything sources them: a fresh key/enabled always wins
# and is never overwritten or read from the old path, the move keeps
# permissions (same filesystem), and a failed move leaves the source in
# place and is logged. After this block only the directory files are read.
[ -d "$CONF_DIR" ] || mkdir -p "$CONF_DIR" || echo "awgmautolist: cannot create $CONF_DIR" >&2
if [ ! -f "$CONF_DIR/enabled" ] && [ -f /opt/etc/awgmautolist.enabled ]; then
    mv /opt/etc/awgmautolist.enabled "$CONF_DIR/enabled" || echo "awgmautolist: legacy enabled migration failed" >&2
fi
if [ ! -f "$CONF_DIR/key" ] && [ -f /opt/etc/awgmautolist.key ]; then
    mv /opt/etc/awgmautolist.key "$CONF_DIR/key" || echo "awgmautolist: legacy key migration failed" >&2
fi
if [ ! -f "$CONF_DIR/awgmautolist.conf" ] && [ -f /opt/etc/awgmautolist.conf ]; then
    mv /opt/etc/awgmautolist.conf "$CONF_DIR/awgmautolist.conf" || echo "awgmautolist: legacy conf migration failed" >&2
fi

# Settings; the working directory is the only supported location for the
# satellite's shell-sourced files after the migration above.
[ -f "$CONF_DIR/awgmautolist.conf" ] && . "$CONF_DIR/awgmautolist.conf"
[ -f "$CONF_DIR/enabled" ] && . "$CONF_DIR/enabled"
[ -f "$CONF_DIR/key" ] && . "$CONF_DIR/key"

ROUTER_URL="${AWGM_ROUTER_URL:-http://127.0.0.1:2222}"
# The panel's settings.json wins over the built-in default when the env is
# unset. Pure busybox sh + sed, no jq/python: take the "port" inside the
# "server" block only — "port" also appears in other blocks (sing-box clash
# api), so the substitution is bracketed by the block range. The panel always
# writes indented JSON; the first match is server.port. Empty/0/out-of-range
# falls back to the built-in default.
if [ -z "$AWGM_ROUTER_URL" ] && [ -f /opt/etc/awg-manager/settings.json ]; then
    SETTINGS_PORT=$(sed -n '/"server"[^{]*{/,/}/s/.*"port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' /opt/etc/awg-manager/settings.json | head -n 1)
    case "$SETTINGS_PORT" in
        ''|*[!0-9]*) SETTINGS_PORT="" ;;
        *) [ "$SETTINGS_PORT" -ge 1 ] && [ "$SETTINGS_PORT" -le 65535 ] || SETTINGS_PORT="" ;;
    esac
    [ -n "$SETTINGS_PORT" ] && ROUTER_URL="http://127.0.0.1:$SETTINGS_PORT"
fi
API_KEY="${AWGM_API_KEY:-}"
LISTEN="${AWGM_LISTEN:-127.0.0.1:2226}"

start() {
    [ "$ENABLED" = "yes" ] || { echo "awgmautolist disabled"; return 0; }
    [ -x "$PROG" ] || { echo "$PROG not found"; return 1; }
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "already running"
        return 0
    fi
    AWGM_API_KEY="$API_KEY"
    export AWGM_API_KEY
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$PROG" -- \
        -router "$ROUTER_URL" -config "$CONF_DIR/config.json" $AWGM_AUTOLIST_ARGS -listen "$LISTEN"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE")
        kill "$pid" 2>/dev/null
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do
            sleep 1
            i=$((i+1))
        done
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then echo running; else echo stopped; fi ;;
    *) echo "usage: $0 {start|stop|restart|status}" ;;
esac
