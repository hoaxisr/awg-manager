#!/bin/sh
# S99awg-manager - AWG Manager service

# Ensure system binaries are in PATH
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:/opt/bin:/opt/sbin:$PATH"

ENABLED=yes
PROCS=awg-manager
DESC="AWG Manager"
BIN="/opt/bin/awg-manager"
PID_FILE="/var/run/awg-manager.pid"
DATA_DIR="/opt/etc/awg-manager"
SETTINGS_FILE="$DATA_DIR/settings.json"

# Read port from settings.json: first "port": N match only. The old
# `grep | tr -cd 0-9` concatenated digits from every matching line and
# broke on minified JSON.
get_port() {
    local port=$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        "$SETTINGS_FILE" 2>/dev/null | head -n 1)
    [ -z "$port" ] && port="2222"
    echo "$port"
}

# Get LAN IP from br0 interface
get_host() {
    local host=$(ip -4 addr show br0 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}')
    [ -z "$host" ] && host="192.168.1.1"
    echo "$host"
}

# Check if binary exists
[ -x "$BIN" ] || exit 0

# Ensure directories exist. /var/run is system tmpfs and always present.
mkdir -p /var/run /opt/var/log "$DATA_DIR"

# is_our_pid returns 0 (true) if $1 is a live awg-manager process, 1
# otherwise. Guards against PID-reuse: after an unclean kill (or the
# pre-move legacy stale-pid case) /proc/$pid may exist but belong to
# some other process that happened to be assigned the same PID.
is_our_pid() {
    local p="$1"
    [ -n "$p" ] && [ -d "/proc/$p" ] && grep -q "awg-manager" "/proc/$p/cmdline" 2>/dev/null
}

start() {
    # 0-байтный бинарь проходит -x и молча «стартует» (#571: сбойная запись
    # на накопитель) — громко в консоль и в syslog роутера.
    if [ ! -s "$BIN" ]; then
        echo "ERROR: $BIN is missing or empty (corrupt install) — reinstall the package"
        logger -t awg-manager -p daemon.err "start failed: $BIN missing or empty (corrupt install)"
        return 1
    fi

    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if is_our_pid "$pid"; then
            echo "$DESC already running (PID $pid)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi

    # Lost-pidfile guard: a daemon started manually (or after /var/run was
    # cleared) must not be doubled — the second instance would lose the port
    # bind and persist a drifted port into settings.json.
    local orphan=$(pidof awg-manager 2>/dev/null)
    if [ -n "$orphan" ]; then
        set -- $orphan
        echo "$1" > "$PID_FILE"
        echo "$DESC already running (PID $1, pid file restored)"
        return 0
    fi

    echo "Starting $DESC..."

    # Start daemon (port is read from settings.json)
    start-stop-daemon -S -b -m -p "$PID_FILE" -x "$BIN" -- \
        -data-dir "$DATA_DIR"

    # Wait for process to start (up to 5 seconds)
    local count=0
    while [ $count -lt 5 ]; do
        sleep 1
        count=$((count + 1))
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if is_our_pid "$pid"; then
            local port=$(get_port)
            local host=$(get_host)
            echo "$DESC started: http://${host}:${port}"
            return 0
        fi
    done

    echo "$DESC failed to start"
    return 1
}

stop() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if is_our_pid "$pid"; then
            echo "Stopping $DESC..."
            kill "$pid" 2>/dev/null

            local count=0
            while is_our_pid "$pid" && [ $count -lt 5 ]; do
                sleep 1
                count=$((count + 1))
            done

            is_our_pid "$pid" && kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi

    # Lost-pidfile guard: kill instances the pid file didn't cover, so
    # "stopped" below is actually true.
    local rest=$(pidof awg-manager 2>/dev/null)
    if [ -n "$rest" ]; then
        echo "Stopping $DESC (no pid file)..."
        kill $rest 2>/dev/null
        local count=0
        while [ -n "$(pidof awg-manager 2>/dev/null)" ] && [ $count -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        rest=$(pidof awg-manager 2>/dev/null)
        [ -n "$rest" ] && kill -9 $rest 2>/dev/null
    fi
    echo "$DESC stopped"
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if is_our_pid "$pid"; then
            local port=$(get_port)
            local host=$(get_host)
            echo "$DESC running (PID $pid): http://${host}:${port}"
            return 0
        fi
    fi
    echo "$DESC not running"
    return 1
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) restart ;;
    status)  status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
