#!/bin/sh

ACTION="$1"

# On upgrade: only stop awg-manager daemon, keep tunnels running
if [ "$ACTION" = "upgrade" ]; then
    echo "Upgrading awg-manager..."
    echo "  Tunnels will continue running during upgrade."
    /opt/etc/init.d/S99awg-manager stop 2>/dev/null || true
    exit 0
fi

# On remove: use awg-manager's own cleanup to properly delete tunnels
echo "Removing awg-manager..."

# Stop the daemon first (if running)
/opt/etc/init.d/S99awg-manager stop 2>/dev/null || true

# Use awg-manager --cleanup to properly delete all managed tunnels
# This uses the service layer which handles:
# - NDMS interface removal (OS 5.x)
# - Process termination
# - Endpoint route cleanup
# - Config file cleanup
# - Storage cleanup
if [ -x /opt/bin/awg-manager ]; then
    echo "Running awg-manager cleanup..."
    /opt/bin/awg-manager --cleanup 2>&1 || true
fi

# Хук перехвата DNS policy-tun переживает удаление пакета и продолжает
# реассертить DNAT в туннель, которого больше нет: правила зашиты прямо в
# него самого, без внешнего файла-гейта, поэтому no-op'ом после удаления не
# становится. Снимаем ЯВНО, вместе с правилами.
# Идёт ПОСЛЕ остановки демона: живой демон вернул бы их на ближайшей сверке.
POLICYTUN_HOOK=/opt/etc/ndm/netfilter.d/52-awgm-policytun-dns.sh
if [ -f "$POLICYTUN_HOOK" ]; then
    echo "Removing policy-tun DNS hook..."
    rm -f "$POLICYTUN_HOOK"
fi
if [ -x /opt/sbin/iptables ]; then
    /opt/sbin/iptables -w -t nat -S PREROUTING 2>/dev/null \
        | grep -- 'AWGM-POLICYTUN-DNS' \
        | sed 's/-A PREROUTING/-D PREROUTING/' \
        | tr -d '"' \
        | while IFS= read -r line; do /opt/sbin/iptables -w -t nat $line 2>/dev/null; done
fi

# Хук туннельного firewall (static-NAT на все ip global выходы) гейтится
# файлом-списком, но сам файл переживает удаление пакета — снимаем оба.
rm -f /opt/etc/ndm/netfilter.d/51-awgm-tunnel-fw.sh /opt/etc/awg-manager/tunnel-fw.list

echo ""
echo "=============================================="
echo "  awg-manager has been removed."
echo ""
echo "  Settings file preserved at:"
echo "    /opt/etc/awg-manager/settings.json"
echo ""
echo "  To remove all remaining data:"
echo "    rm -rf /opt/etc/awg-manager"
echo "=============================================="
echo ""
