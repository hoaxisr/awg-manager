#!/bin/sh

ACTION="$1"

# On upgrade: only stop awg-manager daemon, keep tunnels running
if [ "$ACTION" = "upgrade" ]; then
    echo "Upgrading awg-manager..."
    echo "  Tunnels will continue running during upgrade."
    /opt/etc/init.d/S99awg-manager stop 2>/dev/null || true
    exit 0
fi

# On remove: use awg-manager's own cleanup to properly delete tunnels
echo "Removing awg-manager..."

# Stop the daemon first (if running)
/opt/etc/init.d/S99awg-manager stop 2>/dev/null || true

# Use awg-manager --cleanup to properly delete all managed tunnels
# This uses the service layer which handles:
# - NDMS interface removal (OS 5.x)
# - Process termination
# - Endpoint route cleanup
# - Config file cleanup
# - Storage cleanup
if [ -x /opt/bin/awg-manager ]; then
    echo "Running awg-manager cleanup..."
    /opt/bin/awg-manager --cleanup 2>&1 || true
fi

# Правила awgm-режима переживают удаление пакета: ndm таблицу awgm не трогает,
# а TPROXY в мёртвый сокет молча дропает пакеты до перезагрузки роутера.
# Идёт ПОСЛЕ остановки демона: живой демон вернул бы правила на ближайшей
# сверке. Таблица awgm наша эксклюзивно — флашим её целиком, чужих правил в
# ней быть не может (этим блок и проще nft-предшественника: ни поимённого
# скраба джампов, ни удаления PPE по номерам).
AWGM=/opt/lib/awg-manager/awgm
if [ -x "$AWGM/sbin/iptables" ]; then
    echo "Removing awgm interception rules..."
    I="$AWGM/sbin/iptables"
    $I -t awgm -F 2>/dev/null
    for c in AWGM-TPROXY AWGM-REDIRECT AWGM-BLACKHOLE; do
        $I -t awgm -X "$c" 2>/dev/null
    done
    # Модули выгружаем best-effort: занятые (гонка с чем-то) останутся до
    # ребута с пустой таблицей — это policy ACCEPT, вреда нет.
    for m in xt_AWGMPPE xt_AWGMTPROXY iptable_awgm; do
        rmmod "$m" 2>/dev/null || true
    done
fi

echo ""
echo "=============================================="
echo "  awg-manager has been removed."
echo ""
echo "  Settings file preserved at:"
echo "    /opt/etc/awg-manager/settings.json"
echo ""
echo "  To remove all remaining data:"
echo "    rm -rf /opt/etc/awg-manager"
echo "=============================================="
echo ""
